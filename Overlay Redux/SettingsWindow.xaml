<Window x:Class="Overlay_Redux.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="400" Width="450" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="10">
            <Button x:Name="BtnSave" Click="BtnSave_Click" HorizontalAlignment="Right" Padding="20,5">Save</Button>
        </Border>

        <TabControl Margin="5">
            <TabItem Header="General">
                <StackPanel Margin="10">
                    <TextBlock Text="Active Windows" FontWeight="Bold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkMedsActive" Content="Meds Window" IsChecked="{Binding MedsWindowActive}"/>
                    <CheckBox x:Name="ChkRespawnActive" Content="Respawn Window" IsChecked="{Binding RespawnWindowActive}"/>
                    <CheckBox x:Name="ChkNadesActive" Content="Nades Window" IsChecked="{Binding NadesWindowActive}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Meds">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerMedsBackground"
                                                         Grid.Row="0" Grid.Column="1"
                                                         Width="40" Height="40"
                                                         ShowAlpha="False"
                                                         HorizontalAlignment="Left"
                                                         Margin="0,4"
                                                         ColorChanged="PickerMeds_ColorChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Border Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerMedsBorder"
                                                         Grid.Row="1" Grid.Column="1"
                                                         Width="40" Height="40"
                                                         ShowAlpha="False"
                                                         HorizontalAlignment="Left"
                                                         Margin="0,4"
                                                         ColorChanged="PickerMeds_ColorChanged"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Text Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerMedsText"
                                                         Grid.Row="2" Grid.Column="1"
                                                         Width="40" Height="40"
                                                         ShowAlpha="False"
                                                         HorizontalAlignment="Left"
                                                         Margin="0,4"
                                                         ColorChanged="PickerMeds_ColorChanged"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Nades">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerNadesBackground"
                                             Grid.Row="0" Grid.Column="1"
                                             Width="40" Height="40"
                                             ShowAlpha="False"
                                             HorizontalAlignment="Left"
                                             Margin="0,4"
                                             ColorChanged="PickerNades_ColorChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Border Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerNadesBorder"
                                             Grid.Row="1" Grid.Column="1"
                                             Width="40" Height="40"
                                             ShowAlpha="False"
                                             HorizontalAlignment="Left"
                                             Margin="0,4"
                                             ColorChanged="PickerNades_ColorChanged"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Text Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerNadesText"
                                             Grid.Row="2" Grid.Column="1"
                                             Width="40" Height="40"
                                             ShowAlpha="False"
                                             HorizontalAlignment="Left"
                                             Margin="0,4"
                                             ColorChanged="PickerNades_ColorChanged"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Respawn">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerRespawnBackground"
                                             Grid.Row="0" Grid.Column="1"
                                             Width="40" Height="40"
                                             ShowAlpha="False"
                                             HorizontalAlignment="Left"
                                             Margin="0,4"
                                             ColorChanged="PickerRespawn_ColorChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Text Color"/>
                        <colorpicker:PortableColorPicker x:Name="PickerRespawnText"
                                             Grid.Row="1" Grid.Column="1"
                                             Width="40" Height="40"
                                             ShowAlpha="False"
                                             HorizontalAlignment="Left"
                                             Margin="0,4"
                                             ColorChanged="PickerRespawn_ColorChanged"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Verification">
                <StackPanel Margin="10">
                    <TextBlock Text="Nucleus Hash" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding HashStatus}"/>
                        <Button Grid.Column="1" Margin="5,0,0,0" Padding="10,3"
                                Click="BtnClearHash_Click"
                                IsEnabled="{Binding HashIsSet}">Clear</Button>
                    </Grid>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="Acquire Hash" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="You must be alone in a custom match lobby before initiating."
                               TextWrapping="Wrap" Margin="0,0,0,8" Foreground="Gray"/>

                    <Button x:Name="BtnInitiate" Click="BtnInitiate_Click" 
                            IsEnabled="{Binding CanStartVerification}"
                            HorizontalAlignment="Left" Padding="10,3">Initiate</Button>

                    <TextBlock Text="{Binding VerificationStatusText}" Margin="0,8,0,0"/>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Detected Player" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtCandidateName"
                                   Text="{Binding CandidateName}"
                                   Margin="0,0,0,8"/>
                        <Button x:Name="BtnConfirm" Click="BtnConfirm_Click"
                                IsEnabled="{Binding CanConfirm}"
                                HorizontalAlignment="Left" Padding="10,3">Confirm</Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>