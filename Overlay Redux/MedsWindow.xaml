<Window x:Class="Overlay_Redux.MedsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Overlay_Redux"
        mc:Ignorable="d"
        Title="Meds" Height="325" Width="515" ResizeMode="NoResize"
        Background="{Binding WindowBackground}">
    <Window.Resources>
        <Style TargetType="Image">
            <Setter Property="Height" Value="131"/>
            <Setter Property="Width" Value="131"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="BorderThickness" Value="1.25"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{Binding TextForeground}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border>
            <Grid>
                <TextBlock Text="{Binding Syringes}"/>
                <Image Source="/Images/Syringe.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="1">
            <Grid>
                <TextBlock Text="{Binding MedKits}"/>
                <Image Source="/Images/Med Kit.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="2">
            <Grid>
                <TextBlock Text="{Binding PhoenixKits}"/>
                <Image Source="/Images/Phoenix Kit.png"/>
            </Grid>
        </Border>
        <Border Grid.Row="1">
            <Grid>
                <TextBlock Text="{Binding ShieldCells}"/>
                <Image Source="/Images/Shield Cell.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Grid.Row="1">
            <Grid>
                <TextBlock Text="{Binding ShieldBatts}"/>
                <Image Source="/Images/Shield Battery.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="1">
            <Grid>
                <TextBlock Text="{Binding UltAccels}"/>
                <Image Source="/Images/Ultimate Accelerant.png"/>
            </Grid>
        </Border>
    </Grid>
</Window>