<Window x:Class="Overlay_Redux.MedsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Overlay_Redux"
        mc:Ignorable="d"
        Title="Meds" Height="325" Width="515" ResizeMode="NoResize" Background="DarkGray">
    <Window.Resources>
        <Style x:Key="MedCountBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="1.25"/>
        </Style>
        <Style x:Key="MedCountText" TargetType="TextBlock">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="MedCountImage" TargetType="Image">
            <Setter Property="Height" Value="131"/>
            <Setter Property="Width" Value="131" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource MedCountBorder}">
            <Grid>
                <TextBlock Style="{StaticResource MedCountText}" Text="{Binding Syringes}"/>
                <Image Style="{StaticResource MedCountImage}" Source="/Images/Syringe.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource MedCountBorder}">
            <Grid>
                <TextBlock Style="{StaticResource MedCountText}" Text="{Binding MedKits}"/>
                <Image Style="{StaticResource MedCountImage}" Source="/Images/Med Kit.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource MedCountBorder}">
            <Grid>
                <TextBlock Style="{StaticResource MedCountText}" Text="{Binding PhoenixKits}"/>
                <Image Style="{StaticResource MedCountImage}" Source="/Images/Phoenix Kit.png"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource MedCountBorder}">
            <Grid >
                <TextBlock Style="{StaticResource MedCountText}" Text="{Binding ShieldCells}"/>
                <Image Style="{StaticResource MedCountImage}" Source="/Images/Shield Cell.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource MedCountBorder}">
            <Grid>
                <TextBlock Style="{StaticResource MedCountText}" Text="{Binding ShieldBatts}"/>
                <Image Style="{StaticResource MedCountImage}" Source="/Images/Shield Battery.png"/>
            </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource MedCountBorder}">
            <Grid >
                <TextBlock Style="{StaticResource MedCountText}" Text="{Binding UltAccels}"/>
                <Image Style="{StaticResource MedCountImage}" Source="/Images/Ultimate Accelerant.png"/>
            </Grid>
        </Border>
    </Grid>
</Window>
